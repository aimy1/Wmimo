<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_traffic_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_card_bg"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- Header: Dot + Traffic Title + Profile Name + Refresh Button -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/widget_traffic_dot"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_widget_dot" />

        <TextView
            android:id="@+id/widget_traffic_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/widget_traffic_title"
            android:textColor="@color/widget_text_primary"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_traffic_profile"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:gravity="end"
            android:maxLines="1"
            android:text="@string/widget_no_profile"
            android:textColor="@color/widget_text_secondary"
            android:textSize="11sp" />

        <ImageView
            android:id="@+id/widget_traffic_refresh_btn"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/widget_pill_bg"
            android:contentDescription="@string/widget_refresh"
            android:padding="5dp"
            android:src="@drawable/ic_widget_refresh" />
    </LinearLayout>

    <!-- Speed Blocks: Download & Upload Side by Side -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <!-- Download Block -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:background="@drawable/widget_surface_bg"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:paddingHorizontal="10dp"
            android:paddingVertical="6dp">

            <TextView
                android:id="@+id/widget_traffic_down_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="↓ Download"
                android:textColor="@color/widget_text_secondary"
                android:textSize="10.5sp" />

            <TextView
                android:id="@+id/widget_traffic_down_speed"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="0 B/s"
                android:textColor="@color/widget_accent"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_traffic_down_total"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="0 B"
                android:textColor="@color/widget_text_secondary"
                android:textSize="10.5sp" />
        </LinearLayout>

        <!-- Upload Block -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:background="@drawable/widget_surface_bg"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:paddingHorizontal="10dp"
            android:paddingVertical="6dp">

            <TextView
                android:id="@+id/widget_traffic_up_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="↑ Upload"
                android:textColor="@color/widget_text_secondary"
                android:textSize="10.5sp" />

            <TextView
                android:id="@+id/widget_traffic_up_speed"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="0 B/s"
                android:textColor="@color/widget_amber"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_traffic_up_total"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="0 B"
                android:textColor="@color/widget_text_secondary"
                android:textSize="10.5sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Bottom Quota / Session Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/widget_traffic_quota_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="0 B"
                android:textColor="@color/widget_text_secondary"
                android:textSize="10.5sp" />

            <TextView
                android:id="@+id/widget_traffic_quota_percent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="@color/widget_accent"
                android:textSize="10.5sp"
                android:textStyle="bold" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/widget_traffic_quota_bar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_marginTop="3dp"
            android:max="100"
            android:progress="0"
            android:progressDrawable="@drawable/widget_progress_bar" />
    </LinearLayout>
</LinearLayout>
