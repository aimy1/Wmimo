<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_status_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_card_bg"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- Top Row: Status Dot + Status Text + Mode Pill + Power Toggle -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/widget_status_dot"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_widget_dot" />

        <TextView
            android:id="@+id/widget_status_state_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/tile_disconnected"
            android:textColor="@color/widget_text_primary"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_status_mode_btn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:background="@drawable/widget_pill_active_bg"
            android:paddingHorizontal="8dp"
            android:paddingVertical="3dp"
            android:text="@string/widget_mode_rule"
            android:textColor="@color/widget_accent"
            android:textSize="10.5sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/widget_status_refresh_btn"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/widget_pill_bg"
            android:contentDescription="@string/widget_refresh"
            android:padding="5dp"
            android:src="@drawable/ic_widget_refresh" />

        <ImageView
            android:id="@+id/widget_status_toggle_btn"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:background="@drawable/widget_toggle_off_bg"
            android:contentDescription="@string/widget_tap_connect"
            android:padding="6dp"
            android:src="@drawable/ic_widget_power" />
    </LinearLayout>

    <!-- Middle Card: Current Proxy Node + Latency Badge -->
    <LinearLayout
        android:id="@+id/widget_status_node_card"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1"
        android:background="@drawable/widget_surface_bg"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="10dp"
        android:paddingVertical="6dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_status_node_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/widget_no_nodes"
                android:textColor="@color/widget_text_primary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_status_profile_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/widget_no_profile"
                android:textColor="@color/widget_text_secondary"
                android:textSize="11sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/widget_status_delay_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/widget_pill_bg"
            android:paddingHorizontal="7dp"
            android:paddingVertical="3dp"
            android:text="-- ms"
            android:textColor="@color/widget_green"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Footer Row: Compact Live Speed -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_status_up_speed"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="↑ 0 B/s"
            android:textColor="@color/widget_amber"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_status_down_speed"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="↓ 0 B/s"
            android:textColor="@color/widget_accent"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
